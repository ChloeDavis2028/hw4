# Copy this file to .env (next to this file or inside backend/) and fill in your own key.
# Never commit or submit your real .env.
PORTKEY_API_KEY=your-portkey-api-key-here

# OpenAI model via Portkey: gpt-5.6-luna (default, course budget), gpt-5.6-terra, gpt-5.6-sol, or gpt-6-astra
OPENAI_MODEL=gpt-5.6-luna
